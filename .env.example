APP_NAME=MediGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev và production dùng cùng dòng MySQL 8.4.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediguard
DB_USERNAME=mediguard
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Hàng đợi chạy bằng driver database ở giai đoạn đầu; chỉ thêm Redis khi bài đo
# tải thực tế cho thấy cần.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="mediguard@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- MediGuard ---
# Kho tệp riêng tư. Không đặt dưới web root: thư mục này chứa dữ liệu bệnh nhân.
MEDIGUARD_DISK=local
MEDIGUARD_STORAGE_ROOT=mediguard
MEDIGUARD_MAX_UPLOAD_MB=512

# Tên cột cuối trên tệp trả lại BHYT. Cần bệnh viện xác nhận trước khi chốt.
MEDIGUARD_EXPORT_COLUMN="ĐÃ GIẢI TRÌNH"
MEDIGUARD_FILL_ACCEPTED_ROWS=false
MEDIGUARD_FILL_SUMMARY_ROWS=false

MEDIGUARD_IMPORT_CHUNK=500
MEDIGUARD_DUE_DAYS=7
MEDIGUARD_PAGE_SIZE=50

VITE_APP_NAME="${APP_NAME}"
